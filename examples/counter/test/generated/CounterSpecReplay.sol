import { QuintTrace } from "quint-sol-connect/QuintTrace.sol";

import { CounterSpec } from "./CounterSpec.sol";

/// Replay half of the driver for examples/counter/spec/counter.qnt.
///
/// A concrete driver inherits this and supplies two things: `apply_`, which
/// drives the implementation for one model action, and `_project`, which reads
/// the implementation back into the model's vocabulary.
abstract contract CounterSpecReplay is QuintReplayBase {
    // --- what the driver implements --------------------------------------

    /// Drive the implementation for one model action. External so `_dispatch`
    /// can catch a revert and report it as an enabledness divergence; every
    /// implementation must reject callers other than `address(this)`.
    function apply_(CounterSpec.Action action, CounterSpec.Picks memory picks) external virtual;

    /// Read live implementation state into the model's shape.
    function _project() internal view virtual returns (CounterSpec.State memory);

    // --- the replay loop --------------------------------------------------

    function _replay(string memory path) internal {
        (QuintTrace.Meta memory meta, bytes memory blob) = QuintTrace.load(path, CounterSpec.SCHEMA_HASH);
        _beginTrace(path, meta);

        CounterSpec.Step[] memory steps = abi.decode(blob, (CounterSpec.Step[]));

        for (uint256 i = 0; i < steps.length; i++) {
            _stepIndex = i;
            _mismatches = 0;
            CounterSpec.Step memory s = steps[i];
            string memory name = CounterSpec.actionName(s.action);

            if (quintVerbose >= 1) console2.log("  [%s] %s", vm.toString(i), name);

            // Step 0 is the post-`init` state. There is no action to drive, only
            // the claim that `setUp` left the implementation where the model
            // starts - which is worth checking on its own.
            if (i != 0) {
                _requirePicks(s.action, s.picks);
                _dispatch(abi.encodeCall(this.apply_, (s.action, s.picks)), name);
                if (_diverged) break;
            }
            _assertState(s.post, _project(), name);
            if (_diverged) break;
        }
    }

    /// A pick the action declares must have been drawn. Absence means the spec
    /// and the config disagree about the action's shape, which would otherwise
    /// surface as the driver silently using a zero.
    function _requirePicks(CounterSpec.Action a, CounterSpec.Picks memory p) private pure {
        if (a == CounterSpec.Action.Increment) {
            require(p.hasBy, "counter: action `increment` did not draw nondet pick `by`");
        } else if (a == CounterSpec.Action.Touch) {
            require(p.hasKey, "counter: action `touch` did not draw nondet pick `key`");
        }
    }

    /// Compare every state variable, accumulating rather than short-circuiting,
    /// so one step reports every field that moved.
    function _assertState(CounterSpec.State memory model_, CounterSpec.State memory chain, string memory action)
        private
    {
        _mismatches += _eqU("count", model_.count, chain.count);
        _mismatches += _eqStr("status", CounterSpec.statusName(model_.status), CounterSpec.statusName(chain.status));
        _mismatches += _cmpArrUint256("seen", model_.seen, chain.seen);
        _mismatches += _cmpArrCounterSpec_EntriesEntry("entries", model_.entries, chain.entries);
        _reportIfDiverged(action);
    }

    function _cmpArrUint256(string memory f, uint256[] memory m, uint256[] memory c) private returns (uint256 n) {
        n += _eqU(string.concat(f, ".length"), m.length, c.length);
        // Lengths differing makes element-wise output noise, not signal.
        if (m.length != c.length) return n;
        for (uint256 i = 0; i < m.length; i++) {
            n += _eqU(string.concat(f, "[", vm.toString(i), "]"), m[i], c[i]);
        }
    }

    function _cmpArrCounterSpec_EntriesEntry(
        string memory f,
        CounterSpec.EntriesEntry[] memory m,
        CounterSpec.EntriesEntry[] memory c
    ) private returns (uint256 n) {
        n += _eqU(string.concat(f, ".length"), m.length, c.length);
        // Lengths differing makes element-wise output noise, not signal.
        if (m.length != c.length) return n;
        for (uint256 i = 0; i < m.length; i++) {
            n += _cmpEntriesEntry(string.concat(f, "[", vm.toString(i), "]"), m[i], c[i]);
        }
    }

    function _cmpEntriesEntry(string memory f, CounterSpec.EntriesEntry memory m, CounterSpec.EntriesEntry memory c)
        private
        returns (uint256 n)
    {
        n += _eqU(string.concat(f, ".key"), m.key, c.key);
        n += _eqU(string.concat(f, ".hits"), m.hits, c.hits);
        n += _eqB(string.concat(f, ".flagged"), m.flagged, c.flagged);
    }
}
